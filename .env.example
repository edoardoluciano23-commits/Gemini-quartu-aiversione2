# URL base del server di inferenza OpenAI-compatible (LM Studio, LM Studio).
LLM_BASE_URL=http://127.0.0.1:1234/v1

# Modello della versione Free (obbligatorio all'avvio, IBM Granite 4.0 H 350M).
LLM_MODEL_FREE=granite4:350m-h

# Modello della versione Pro (Ternary Bonsai 1.7B).
LLM_MODEL_PRO=MichelRosselli/ternary-bonsai:1.7b-f16

# Modello della versione Ultra (Qwen 2.5 3B).
LLM_MODEL_ULTRA=qwen2.5:3b

# Timeout complessivo (ms) della richiesta verso il modello.
LLM_TIMEOUT_MS=120000

# Percorso del database SQLite.
DATABASE_PATH=./database.sqlite

# "true" SOLO dietro un reverse proxy fidato che sovrascrive X-Forwarded-For.
TRUST_PROXY=false

